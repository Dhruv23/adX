# phase_13.md 4.6: amapiano_log. Paste it onto a kit channel; the keys are General MIDI's.
[PROJECT]
ADX_VERSION=2

[TEMPO]
0:0:0 112

[CHANNEL Drums]
INSTRUMENT=drumsynth
PARAM model=5
OUTPUT=insert.1

[PATTERN amapiano_log]
LENGTH=1:0:0
NOTES Drums
  C2 0:0:0 0:0:480 110
  C2 0:1:0 0:0:480 110
  C2 0:2:0 0:0:480 110
  C2 0:3:0 0:0:480 110
  D4 0:0:2880 0:0:480 90
  D4 0:1:1920 0:0:480 90
  D4 0:2:1920 0:0:480 90
  D4 0:3:960 0:0:480 90
  D#5 0:0:1920 0:0:480 90
  D#5 0:1:1920 0:0:480 90
  D#5 0:2:1920 0:0:480 90
  D#5 0:3:1920 0:0:480 90

[MIXER]
INSERT 1 name="Master"
