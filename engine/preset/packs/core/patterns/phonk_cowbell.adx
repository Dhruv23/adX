# phase_13.md 4.6: phonk_cowbell. Paste it onto a kit channel; the keys are General MIDI's.
[PROJECT]
ADX_VERSION=2

[TEMPO]
0:0:0 130

[CHANNEL Drums]
INSTRUMENT=drumsynth
PARAM model=5
OUTPUT=insert.1

[PATTERN phonk_cowbell]
LENGTH=2:0:0
NOTES Drums
  C2 0:0:0 0:0:480 110
  C2 0:1:1920 0:0:480 90
  C2 0:3:0 0:0:480 110
  C2 1:0:0 0:0:480 110
  C2 1:1:1920 0:0:480 90
  C2 1:2:1920 0:0:480 90
  G#3 0:0:0 0:0:480 110
  G#3 0:0:2880 0:0:480 90
  G#3 0:1:1920 0:0:480 90
  G#3 0:2:0 0:0:480 110
  G#3 0:2:2880 0:0:480 90
  G#3 0:3:1920 0:0:480 90
  G#3 1:0:0 0:0:480 110
  G#3 1:0:2880 0:0:480 90
  G#3 1:1:1920 0:0:480 90
  G#3 1:2:0 0:0:480 110
  G#3 1:2:1920 0:0:480 90
  G#3 1:3:0 0:0:480 110

[MIXER]
INSERT 1 name="Master"
