# phase_13.md 4.6: trap_hats_rolls. Paste it onto a kit channel; the keys are General MIDI's.
[PROJECT]
ADX_VERSION=2

[TEMPO]
0:0:0 140

[CHANNEL Drums]
INSTRUMENT=drumsynth
PARAM model=5
OUTPUT=insert.1

[PATTERN trap_hats_rolls]
LENGTH=2:0:0
NOTES Drums
