# phase_13.md 4: 707 Machine Kit.
[RACK]
NAME="707 Machine Kit"
PACK=core
CATEGORY=Drums/Kit
TAGS=707, kit
TEMPO_HINT=96
ROOT_HINT=C2
VERSION=1

[LAYER kick]
PRESET="core/808 Kick Short"
KEYS=35..36
GAIN=0.51
PARAM character=2

[LAYER snare]
PRESET="core/808 Snare"
KEYS=37..38
GAIN=0.51
PARAM character=2

[LAYER clap]
PRESET="core/808 Clap"
KEYS=39..39
GAIN=0.51
PARAM character=2

[LAYER hat]
PRESET="core/808 Hat Pair"
KEYS=42..46
GAIN=0.51
PARAM character=2

[LAYER tomfloor]
PRESET="core/808 Tom Low"
KEYS=41..41
GAIN=0.51
PARAM character=2

[LAYER tomfloorhigh]
PRESET="core/808 Tom Low"
KEYS=43..43
GAIN=0.51
PARAM character=2

[LAYER tomlow]
PRESET="core/808 Tom Mid"
KEYS=45..45
GAIN=0.51
PARAM character=2

[LAYER tommid]
PRESET="core/808 Tom Mid"
KEYS=47..48
GAIN=0.51
PARAM character=2

[LAYER tomhigh]
PRESET="core/808 Tom High"
KEYS=50..50
GAIN=0.51
PARAM character=2

[LAYER cymbal]
PRESET="core/808 Cymbal"
KEYS=49..49
GAIN=0.51
PARAM character=2

[LAYER ride]
PRESET="core/808 Cymbal"
KEYS=51..51
GAIN=0.51
PARAM character=2

[LAYER cowbell]
PRESET="core/808 Cowbell"
KEYS=56..56
GAIN=0.51
PARAM character=2

[LAYER conga]
PRESET="core/808 Conga Mid"
KEYS=60..64
GAIN=0.51
PARAM character=2

[LAYER clave]
PRESET="core/808 Clave"
KEYS=75..77
GAIN=0.51
PARAM character=2

[CHAIN]
SLOT Compressor threshold=-12 ratio=4 attack=10 release=80
SLOT Saturation model=0 drive=4
SLOT Clipper mode=0 drive=0 ceiling=-1

[MACRO Pitch]
VALUE=0.5
TARGET layer.kick.tune range=-12..12
TARGET layer.snare.tune range=-12..12
TARGET layer.tomfloor.tune range=-12..12
TARGET layer.tomfloorhigh.tune range=-12..12
TARGET layer.tomlow.tune range=-12..12
TARGET layer.tommid.tune range=-12..12
TARGET layer.tomhigh.tune range=-12..12

[MACRO Decay]
VALUE=0.5
TARGET layer.kick.decay range=0.05..1.2 curve=exponential(0.3)
TARGET layer.snare.decay range=0.05..1.2 curve=exponential(0.3)

[MACRO Drive]
VALUE=0.5
TARGET chain.2.drive range=0..12

[MACRO Tone]
VALUE=0.5
TARGET layer.snare.tone range=0.2..0.95
TARGET layer.hat.tone range=0.2..0.95
