# Mirrors .clang-format and the ruff config for editors that read neither.
# .clang-format and pyproject.toml remain authoritative; this file exists so a
# file is already close to correct before the formatter runs.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{c,cc,cpp,h,hpp,in}]
max_line_length = 100

[*.py]
max_line_length = 100

[*.{json,yml,yaml}]
indent_size = 2

[{CMakeLists.txt,*.cmake}]
indent_size = 4

[*.md]
# Reflowing a hard-wrapped document on save produces diffs nobody asked for.
trim_trailing_whitespace = false

[*.adx]
# The format is the project (FINAL_PLAN §6): one musical event per line, stable
# ordering, no reflowing on save.
indent_size = 2
trim_trailing_whitespace = false

[_archive/**]
# Read-only reference. Nothing here is edited; leave it exactly as it was.
trim_trailing_whitespace = false
insert_final_newline = false
