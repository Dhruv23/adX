[PLAYLIST]
TRACK 1 name="Kick"
  PATTERN Kick 0:0:0
TRACK 2 name="SubBass"
  PATTERN SubBass 0:0:0
TRACK 3 name="Lead"
  PATTERN Lead 0:0:0
TRACK 4 name="Pad"
  PATTERN Pad 0:0:0
TRACK 5 name="Vocal"
  PATTERN Vocal 0:0:0
TRACK 6 name="Snare"
  PATTERN Snare 0:0:0
TRACK 7 name="Hat"
  PATTERN Hat 0:0:0
TRACK 8 name="Automation"
  AUTOMATION channel.Lead.resfilter.cutoff 0:0:0
    0:0:0 180 exponential
    8:0:0 900 exponential
    16:0:0 3200 exponential
    24:0:0 500
    28:0:0 3400 exponential
    36:0:0 400 exponential
  AUTOMATION channel.Pad.volume 0:0:0
    0:0:0 0.2
    8:0:0 0.5 smooth
    16:0:0 0.7 smooth
    36:0:0 0 smooth
  AUTOMATION channel.Vocal.formant.morph 0:0:0
    8:0:0 0
    16:0:0 1 smooth
    24:0:0 0.3
    28:0:0 1 smooth
  AUTOMATION insert.8.slot.17.mix 0:0:0
    8:0:0 0.3 step
    24:0:0 0.7 step
    28:0:0 0.4 step
  AUTOMATION insert.1.slot.4.amount 0:0:0
    8:0:0 0 step
    16:0:0 0.7 step
    24:0:0 0 step
    28:0:0 0.7 step
    36:0:0 0 step
  AUTOMATION insert.1.slot.3.mix 0:0:0
    0:0:0 0.55
    24:0:0 0.85 smooth
    28:0:0 0.45 smooth

[MIXER]
INSERT 1 name="Master" gain=0.8
  SLOT 1 Distortion drive=3
  SLOT 2 Delay mix=0.28 timeMs=375 feedback=0.42
  SLOT 3 Reverb mix=0.5 room=0.85 damp=0.4
  SLOT 4 Ducker enabled=1 amount=0.7 releaseMs=130
INSERT 2 name="Kick"
  SLOT 5 Distortion drive=6
INSERT 3 name="SubBass" gain=0.9
  SLOT 6 Distortion mix=0.9 drive=12
  SLOT 7 EQ low=4 mid=0 high=-2
  SLOT 8 Bitcrush mix=0.3 bits=10 rate=14000
INSERT 4 name="Lead" gain=0.7 pan=-0.1
  SLOT 9 Bitcrush mix=0.25 bits=12 rate=18000
  SLOT 10 Distortion mix=0.6 drive=4
  SLOT 11 Chorus mix=0.5 rate=0.8 depth=0.4
  SLOT 12 EQ low=-5 mid=0 high=2
  SEND 1 insert.5 level=0.4
  SEND 2 insert.6 level=0.5
INSERT 5 name="Delay Bus"
INSERT 6 name="Reverb Bus"
INSERT 7 name="Pad" gain=0.5
  SLOT 13 Chorus mix=0.6 rate=0.5 depth=0.6
  SLOT 14 Bitcrush mix=0.2 bits=12 rate=16000
  SLOT 15 Reverb mix=0.55 room=0.9 damp=0.4
  SLOT 16 EQ low=2 mid=-2 high=-3
  SEND 3 insert.6 level=0.4
INSERT 8 name="Vocal" gain=0.88 pan=0.05
  SLOT 17 Bitcrush mix=0.35 bits=10 rate=14000
  SLOT 18 Reverb mix=0.5 room=0.85 damp=0.45
  SEND 4 insert.5 level=0.5
  SEND 5 insert.6 level=0.35
INSERT 9 name="Snare" gain=0.7
  SLOT 19 Distortion mix=0.6 drive=5
  SLOT 20 Reverb mix=0.4 room=0.7 damp=0.3
INSERT 10 name="Hat" gain=0.4 pan=0.12
  SLOT 21 Bitcrush mix=0.4 bits=6 rate=10000
ROUTE insert.2 -> insert.1
ROUTE insert.3 -> insert.1
ROUTE insert.4 -> insert.1
ROUTE insert.5 -> insert.1
ROUTE insert.6 -> insert.1
ROUTE insert.7 -> insert.1
ROUTE insert.8 -> insert.1
ROUTE insert.9 -> insert.1
ROUTE insert.10 -> insert.1

