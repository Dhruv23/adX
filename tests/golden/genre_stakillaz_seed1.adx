[PLAYLIST]
TRACK 1 name="Music"
  PATTERN Intro 0:0:0
  PATTERN Build 4:0:0
  PATTERN Drop 8:0:0
  PATTERN Break 12:0:0
  PATTERN "Drop 2" 16:0:0

[MIXER]
INSERT 1 name="Master"
  SLOT 1 Distortion drive=4
  SLOT 2 Bitcrush mix=0.35 bits=10 rate=14000
  SLOT 5 Limiter
INSERT 2 name="Kick"
INSERT 3 name="Low" gain=0.85
  SLOT 3 Ducker sidechain=insert.2 enabled=1 amount=0.7 releaseMs=130
INSERT 4 name="Lead" gain=0.7
  SLOT 4 Ducker sidechain=insert.2 enabled=1 amount=0.7 releaseMs=130
ROUTE insert.2 -> insert.1
ROUTE insert.3 -> insert.1
ROUTE insert.4 -> insert.1

[MARKERS]
0:0:0 "Intro"
4:0:0 "Build"
8:0:0 "Drop"
12:0:0 "Break"
16:0:0 "Drop 2"
