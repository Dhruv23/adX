[PATTERN Rise]
LENGTH=8:0:0
NOTES "Noise Riser 8/noise"
  C4 0:0:0 8:0:0 110

[PATTERN Hit]
LENGTH=2:0:0
NOTES Impact/drop
  C2 0:0:0 1:0:0 110
NOTES Impact/burst
  C2 0:0:0 1:0:0 110
NOTES Impact/crash
  C2 0:0:0 1:0:0 110

[PLAYLIST]
TRACK 1 name="Intro Drums"
  PATTERN "Intro Drums" 0:0:0
TRACK 2 name="Build Drums"
  PATTERN "Build Drums" 8:0:0
TRACK 3 name="Build Bass"
  PATTERN "Build Bass" 8:0:0
TRACK 4 name="Drop Drums"
  PATTERN "Drop Drums" 16:0:0
TRACK 5 name="Drop Bass"
  PATTERN "Drop Bass" 16:0:0
TRACK 6 name="Outro Drums"
  PATTERN "Outro Drums" 28:0:0
TRACK 7 name="Rise"
  PATTERN Rise 8:0:0
TRACK 8 name="Hit"
  PATTERN Hit 16:0:0

[MIXER]
INSERT 1 name="Master"
INSERT 2 name="808 Kit"
  SLOT 1 Compressor threshold=-12 ratio=4 attack=10 release=80
  SLOT 2 Saturation model=0 drive=4
  SLOT 3 Clipper mode=0 drive=0 ceiling=-1
INSERT 3 name="808 Distorted"
  SLOT 4 Overdrive drive=20 tone=3500
  SLOT 5 Clipper mode=0 drive=6
  SLOT 6 ParametricEq band1.type=3 band1.freq=25
INSERT 4 name="Noise Riser 8"
  SEND 1 insert.5 level=0.39810717
INSERT 5 name="Noise Riser 8/space"
  SLOT 7 Hall size=0.8 decay=3
INSERT 6 name="Impact"
  SEND 2 insert.7 level=0.5011872
INSERT 7 name="Impact/space"
  SLOT 8 Hall size=0.9 decay=6
ROUTE insert.2 -> insert.1
ROUTE insert.3 -> insert.1
ROUTE insert.4 -> insert.1
ROUTE insert.5 -> insert.1
ROUTE insert.6 -> insert.1
ROUTE insert.7 -> insert.1

[MACRO 808 Kit/Pitch]
VALUE=0.5
TARGET channel."808 Kit/kick".tune range=-12..12
TARGET channel."808 Kit/snare".tune range=-12..12
TARGET channel."808 Kit/tomfloor".tune range=-12..12
TARGET channel."808 Kit/tomfloorhigh".tune range=-12..12
TARGET channel."808 Kit/tomlow".tune range=-12..12
TARGET channel."808 Kit/tommid".tune range=-12..12
TARGET channel."808 Kit/tomhigh".tune range=-12..12

[MACRO 808 Kit/Decay]
VALUE=0.5
TARGET channel."808 Kit/kick".decay range=0.05..1.2 curve=exponential(0.3)
TARGET channel."808 Kit/snare".decay range=0.05..1.2 curve=exponential(0.3)

[MACRO 808 Kit/Drive]
VALUE=0.5
TARGET insert.2.slot.2.drive range=0..12

[MACRO 808 Kit/Tone]
VALUE=0.5
TARGET channel."808 Kit/snare".tone range=0.2..0.95
TARGET channel."808 Kit/hat".tone range=0.2..0.95

[MACRO 808 Distorted/Drive]
VALUE=0.5
TARGET insert.3.slot.4.drive range=6..30
