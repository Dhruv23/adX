# =====================================================================
# [P2] AUTOMATION  -  [AUTOMATION <Track> <target>] then: beat value curve
# curve: lin | exp | step | smooth. Track MASTER targets master.* fields.
# =====================================================================

[AUTOMATION Lead patch.resFilterCutoff]
0 180 exp
32 900 exp
64 3200 exp
96 500 lin
112 3400 exp
144 400 exp

[AUTOMATION Pad mix.volume]
0 0.2 lin
32 0.5 smooth
64 0.7 smooth
144 0 smooth

[AUTOMATION Vocal patch.formantMorph]
32 0 lin
64 1 smooth
96 0.3 lin
112 1 smooth

[AUTOMATION Vocal effect.Bitcrush.mix]
32 0.3 step
96 0.7 step
112 0.4 step

[AUTOMATION MASTER master.sidechainAmount]
32 0 step
64 0.7 step
96 0 step
112 0.7 step
144 0 step

[AUTOMATION MASTER master.reverbMix]
0 0.55 lin
96 0.85 smooth
112 0.45 smooth
