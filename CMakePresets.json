{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 26,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-x64-base",
      "hidden": true,
      "description": "Ninja only: clang-tidy needs a compile database, which the Visual Studio generator does not emit (phase_0.md §9).",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-x64-debug",
      "displayName": "Windows x64 Debug",
      "inherits": "windows-x64-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "windows-x64-relwithdebinfo",
      "displayName": "Windows x64 RelWithDebInfo",
      "inherits": "windows-x64-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "windows-x64-release",
      "displayName": "Windows x64 Release",
      "inherits": "windows-x64-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-x64-debug",
      "configurePreset": "windows-x64-debug"
    },
    {
      "name": "windows-x64-relwithdebinfo",
      "configurePreset": "windows-x64-relwithdebinfo"
    },
    {
      "name": "windows-x64-release",
      "configurePreset": "windows-x64-release"
    }
  ],
  "testPresets": [
    {
      "name": "windows-x64-base",
      "hidden": true,
      "configurePreset": "windows-x64-base",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false
      }
    },
    {
      "name": "windows-x64-debug",
      "inherits": "windows-x64-base",
      "configurePreset": "windows-x64-debug"
    },
    {
      "name": "windows-x64-relwithdebinfo",
      "inherits": "windows-x64-base",
      "configurePreset": "windows-x64-relwithdebinfo"
    },
    {
      "name": "windows-x64-release",
      "inherits": "windows-x64-base",
      "configurePreset": "windows-x64-release"
    }
  ]
}
