; Stock firmware V16 (2026-10-21): 8 parts on channels 1-8, key LEDs; FX CCs 70-93.
; The FX CC order below is adX's reading of M-VAVE's CC page (phase_11.5.md 4.9).
; It is UNVERIFIED until the final review checks it on a device; a wrong row is
; fixed here, not in code.
[DEVICE_PROFILE]
NAME="M-Vave FM-1 (V16)"
MATCH_DEVICE="FM-1 Midi"
MATCH_MODEL="FM-1_016"
PARTS=8
EFFECT_CHANNEL=2
BEND_RANGE_MAX=24
LED_NOTES=0-26
FEEDBACK=onoff
SENDS_VELOCITY=probe

[PART_CC]
MOD=1
BREATH=2
FOOT=4
VOLUME=7
EXPRESSION=11
SUSTAIN=64

[FX_CC]
FILTER_TYPE=70
FILTER_CUTOFF=71
FILTER_RESO=72
DIST_DRIVE=73
DIST_TONE=74
DIST_MIX=75
CHORUS_RATE=76
CHORUS_DEPTH=77
CHORUS_MIX=78
PHASER_RATE=79
PHASER_DEPTH=80
PHASER_FEEDBACK=81
PHASER_MIX=82
DELAY_TIME=83
DELAY_FEEDBACK=84
DELAY_TONE=85
DELAY_SYNC=86
DELAY_MIX=87
REVERB_TYPE=88
REVERB_SIZE=89
REVERB_DAMPING=90
REVERB_PREDELAY=91
REVERB_WIDTH=92
REVERB_MIX=93
