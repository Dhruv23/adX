; Stock firmware V15: velocity from the keys; one part; FX CCs 0-23.
; The FX CC order below is adX's reading of M-VAVE's CC page (phase_11.5.md 4.9).
; It is UNVERIFIED until the final review checks it on a device; a wrong row is
; fixed here, not in code.
[DEVICE_PROFILE]
NAME="M-Vave FM-1 (V15)"
MATCH_DEVICE="FM-1 Midi"
MATCH_MODEL="FM-1_015"
PARTS=1
EFFECT_CHANNEL=2
BEND_RANGE_MAX=12
LED_NOTES=none
FEEDBACK=none
SENDS_VELOCITY=probe

[PART_CC]
MOD=1
BREATH=2
FOOT=4
SUSTAIN=64

[FX_CC]
FILTER_TYPE=0
FILTER_CUTOFF=1
FILTER_RESO=2
DIST_DRIVE=3
DIST_TONE=4
DIST_MIX=5
CHORUS_RATE=6
CHORUS_DEPTH=7
CHORUS_MIX=8
PHASER_RATE=9
PHASER_DEPTH=10
PHASER_FEEDBACK=11
PHASER_MIX=12
DELAY_TIME=13
DELAY_FEEDBACK=14
DELAY_TONE=15
DELAY_SYNC=16
DELAY_MIX=17
REVERB_TYPE=18
REVERB_SIZE=19
REVERB_DAMPING=20
REVERB_PREDELAY=21
REVERB_WIDTH=22
REVERB_MIX=23
